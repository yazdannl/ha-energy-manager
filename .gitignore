# Runtime data — never commit (SPEC.md R1)
data/
*.db
*.db-wal
*.db-shm
*.log
*.sqlite
options.json
captures/
local/

# Runtime JSON artefacts — never commit (SPEC.md R1).
# Test fixtures are the one exception; put them under tests/.
*.json
!tests/*.json
!tests/**/*.json

# Trained model artefacts are the second exception: they are fitted offline by tools/forecast_ml and
# committed on purpose so a model change is reviewable in a diff. Scoped to those two directories
# alone — the one under the add-on is what actually ships and is what the parity test pins.
!tools/forecast_ml/models/*.json
!energy_manager/app/forecast/models/*.json

# Local environment
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env
.env.*
node_modules/

# Editors / OS
.idea/
.vscode/
.DS_Store
